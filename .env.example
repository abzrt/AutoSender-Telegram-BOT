# Token bot dari @BotFather di Telegram
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Zona waktu jadwal (contoh: Asia/Jakarta, Asia/Makassar, Asia/Jayapura)
TIMEZONE=Asia/Jakarta

# Opsional: daftar User ID Telegram yang boleh menjalankan /list, /test, /reload
# Pisahkan dengan koma jika lebih dari satu (kosongkan jika tidak dibatasi)
ADMIN_IDS=

# Path file konfigurasi jadwal
SCHEDULES_FILE=schedules.json
